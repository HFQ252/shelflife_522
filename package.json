{
  "name": "product-expiry-system",
  "version": "3.2.0",
  "description": "商品保质期临期提醒管理系统 - 修复版",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "setup-db": "node -e \"const fs=require('fs');const dir=process.env.DATABASE_DIR||'./data';if(!fs.existsSync(dir))fs.mkdirSync(dir,{recursive:true})\"",
    "postinstall": "npm run setup-db"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "express": "4.18.2",
    "express-rate-limit": "7.1.5",
    "express-session": "1.17.3",
    "helmet": "7.1.0",
    "sqlite3": "5.1.7"
  },
  "devDependencies": {
    "nodemon": "3.0.1"
  },
  "keywords": ["product", "expiry", "management", "inventory", "barcode", "qrcode"],
  "author": "Product Expiry System Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}